# これを .env.local にコピーするとバックエンドに繋がる。
# ファイルが無ければ localStorage だけで完結するオフラインモードで動く。
#
# /api にすると Vite の dev プロキシ経由（http://localhost:3334）になり、
# ブラウザは 5173 としか話さないので CORS 設定が要らない。
VITE_API_URL=/api

# ngrok 等で実機確認するときは絶対URLでもよい。
# その場合だけ backend の CORS_ORIGIN を合わせる必要がある
# VITE_API_URL=https://xxxx.ngrok.io/api
